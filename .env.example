# ─── Postgres ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contexta

# ─── Contexta Backend ─────────────────────────────────────
CONTEXTA_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contexta
CONTEXTA_REDIS_URL=redis://localhost:6379/0
CONTEXTA_CELERY_BROKER_URL=redis://localhost:6379/1
CONTEXTA_CELERY_RESULT_BACKEND=redis://localhost:6379/2
CONTEXTA_CELERY_TASK_ALWAYS_EAGER=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# REQUIRED in production — never commit a real value.
CONTEXTA_SECRET_KEY=change-me-in-production-use-a-long-random-string

# ─── Engine mode: offline (default, Qwen3 local, no keys) / online / auto ──
CONTEXTA_ENGINE_MODE=offline
CONTEXTA_LOCAL_MODEL_SERVER_URL=http://localhost:8001
MODEL_CACHE_DIR=./models

# ─── Extractor (the fine-tuned LFM2.5 that turns observations into memories) ──
# Ollama now runs as a container in the compose stack, so nothing needs to be
# installed on the host. A one-shot `extractor-provision` container makes sure
# the model exists before the inference server starts, and fails loudly if it
# cannot, rather than letting the stack come up with silent regex-fallback
# extraction.
#
# Published model: point this at an Ollama-registry model and it is pulled on
# first boot. This is the setting that makes `docker compose up` work for
# someone who has never run Contexta before.
CONTEXTA_EXTRACTOR_MODEL_REF=

# Local model: or drop the GGUF and its Modelfile into ./models (host ./models
# maps to /models in the container):
#   models/contexta-lfm-extract-q4_k_m.gguf
#   models/Modelfile
# Build them with benchmarks/extraction/sft/export_gguf.sh.
# A registry ref is tried first; the local GGUF is the fallback, so air-gapped
# installs work with no network.
CONTEXTA_EXTRACTOR_GGUF=/models/contexta-lfm-extract-q4_k_m.gguf

# Chunking. Measured on the real model: single-shot extraction captured 13 of 90
# facts in a long conversation, chunked captured 70. The model has 128k of
# context yet still drops facts, so this is a recall fix rather than a token
# guard. Do not raise the chunk size without re-measuring.
CONTEXTA_INFERENCE_MODEL=contexta-lfm-extract
CONTEXTA_INFERENCE_CHUNK_SENTENCES=10
CONTEXTA_INFERENCE_CHUNK_MAX_CHARS=1600
CONTEXTA_INFERENCE_CHUNK_MAX_TOKENS=2048

# ─── LLM (BYOK for online mode) ─────────────────────────────
# Offline default uses local Qwen3-Reranker. For online, e.g.:
# CONTEXTA_LLM_PROVIDER=openai
# CONTEXTA_LLM_MODEL=gpt-4o-mini
# CONTEXTA_LLM_API_KEY=
CONTEXTA_LLM_PROVIDER=local
CONTEXTA_LLM_MODEL=Qwen/Qwen3-Reranker-0.6B
CONTEXTA_LLM_API_KEY=
# DeepSeek-compatible example:
# CONTEXTA_LLM_PROVIDER=deepseek
# CONTEXTA_LLM_BASE_URL=https://api.deepseek.com/v1
# CONTEXTA_LLM_MODEL=deepseek-chat
CONTEXTA_EMBEDDING_PROVIDER=local
CONTEXTA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
CONTEXTA_EMBEDDING_DIMENSIONS=1024
CONTEXTA_EMBEDDING_API_KEY=
# Online example (1536-dim):
# CONTEXTA_EMBEDDING_PROVIDER=openai
# CONTEXTA_EMBEDDING_MODEL=text-embedding-3-small
# CONTEXTA_EMBEDDING_DIMENSIONS=1536

# ─── Dashboard ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-secret-key-change-in-prod
CONTEXTA_API_URL=http://localhost:8000

# The operator console ships WITHOUT a sign-in, because Contexta is a
# self-hosted, single-operator tool. `off` | `on`.
#   off -> the console resolves its tenant from the values below and trusts it.
#   on  -> restore the NextAuth credentials flow (multi-user).
# With auth off, do NOT expose :3000 to an untrusted network: anyone who can
# reach it acts as whatever tenant resolved here.
CONTEXTA_DASHBOARD_AUTH=off

# How the console resolves its tenant when auth is off, in order of precedence:
#   1. the `contexta_tenant` cookie (changeable in the UI)
#   2. CONTEXTA_DASHBOARD_ORG_ID + CONTEXTA_DASHBOARD_USER_ID
#   3. CONTEXTA_DASHBOARD_API_KEY (the console asks the API which org it owns)
# Leave all three empty and the console reports "unresolved" and sends its API
# calls out unauthenticated, rather than silently acting on another tenant.
CONTEXTA_DASHBOARD_ORG_ID=
CONTEXTA_DASHBOARD_USER_ID=
CONTEXTA_DASHBOARD_API_KEY=

# ─── MCP (agent integrations: Claude Desktop, Cursor, Windsurf) ──────────
# REQUIRED. The MCP server refuses to start without a valid key, by design —
# it will crash-loop rather than come up unauthenticated. Mint one with:
#   python scripts/bootstrap_key.py --name my-agent
# It prints CONTEXTA_MCP_API_KEY=... — paste that value here.
CONTEXTA_MCP_API_KEY=

# Escape hatch for local development only. `true` disables MCP authentication
# entirely. Never set this on anything reachable from a network you care about.
CONTEXTA_MCP_ALLOW_ANONYMOUS=false

