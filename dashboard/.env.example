# ---------------------------------------------------------------------------
# Operator dashboard (Next.js, port 3000)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
CONTEXTA_API_URL=http://localhost:8000

# Page authentication. DEFAULT: off.
# Contexta is a self-hosted, single-operator, offline-first tool, so the console
# ships reachable without a sign-in and authenticates to the Python API with a
# bootstrap API key instead. Set this to `on` to re-enable NextAuth v5 on every
# page (use this for any shared or internet-exposed deployment).
CONTEXTA_DASHBOARD_AUTH=off

# --- Identity used when CONTEXTA_DASHBOARD_AUTH=off -------------------------
# CONTEXTA_DASHBOARD_API_KEY is the recommended single setting. The API resolves
# the organization and actor from the key itself, and the console reads the
# organization back from GET /v1/keys so it can display it.
# Mint one with:  POST /v1/keys  { "name": "dashboard", "organization_id": "<org>", "actor_id": "<user>" }
# The one-time `token` in the response is the value to use here.
CONTEXTA_DASHBOARD_API_KEY=

# Optional. Only needed if you are NOT using an API key. Identity headers alone
# are only accepted by the Python API when it is started with
# CONTEXTA_ALLOW_LEGACY_TENANT_HEADERS=true.
CONTEXTA_DASHBOARD_ORG_ID=
CONTEXTA_DASHBOARD_USER_ID=

# --- NextAuth, only read when CONTEXTA_DASHBOARD_AUTH=on -------------------
AUTH_SECRET=your-nextauth-secret-change-in-production
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
